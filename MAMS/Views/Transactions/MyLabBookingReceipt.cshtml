@using MAMS.Models.ViewModels

@model TransactionReceiptViewModel
@{
    ViewData["Title"] = "My Lab Booking Receipt";
}

<div class="container">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-12 d-flex justify-content-between align-items-center">
                    <h1>My Lab Bookings</h1>
                </div>
                <div class="col-sm-12">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-action="Index">Labs</a></li>
                        <li class="breadcrumb-item active">Lab Booking Slip</li>
                    </ol>
                </div>
            </div><!-- /.row -->
        </div><!-- /.container-fluid -->
    </div>

    <div class="content">
        <div class="card card-widget shadow-lg border-0 rounded-4">
            <div class="card-body">
                <div class="text-center mb-4">
                    <img src="~/img/MedEase.png" alt="MAMS Logo" width="80" />
                    <h4 class="mt-3">MedEase&#8482;</h4>
                    <h5 class="text-secondary">Lab Booking Receipt</h5>
                </div>

                <hr />

                <div class="row mb-2">
                    <div class="col-md-6">
                        <p><strong>Reference No:</strong> @Model.ReferenceNo</p>
                        <p><strong>Patient Name:</strong> @Model.PatientName</p>
                        <p><strong>Lab Test:</strong> @Model.LabTestName</p>
                        <p><strong>Booked Date:</strong> @Model.BookedDate</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Time Slot:</strong> @Model.TimeSlot</p>
                        <p><strong>Payment Method:</strong> @Model.PaymentMethod</p>
                        <p><strong>Amount:</strong> Rs. @Model.AmountPaid</p>
                        <p><strong>Issued Date:</strong> @Model.IssuedDate</p>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a asp-controller="Transactions" asp-action="DownloadReceipt" asp-route-refNo="@Model.ReferenceNo" class="btn btn-success px-4 rounded-pill">
                        <i class="fas fa-download me-2"></i>Download PDF Slip
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>

