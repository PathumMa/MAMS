@using System.Data
@using MAMS.Services
@using MAMS.Models.ViewModels
@using static MAMS.Services.Enums

@{
    ViewData["Title"] = "Search My Labs";
}

@model IEnumerable<TransactionReceiptViewModel>

<div class="container">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <!-- Page Title -->
                <div class="col-sm-12 d-flex justify-content-between align-items-center">
                    <h1>My Lab Bookings</h1>
                </div>

                <!-- Friendly instructions -->
                <div class="col-sm-12 mt-2">
                    <p class="lead text-muted">
                        Use this page to quickly access your lab booking details, receipts, or test reports.
                        Simply enter your reference number in the search bar below and click <strong>Search</strong>.
                    </p>
                    <p class="text-muted fst-italic">
                        Tip: Your reference number can be found on your printed lab appointment receipt or confirmation email.
                    </p>
                </div>

                <!-- Breadcrumb navigation -->
                <div class="col-sm-12">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-action="Index">Labs</a></li>
                        <li class="breadcrumb-item active">Search</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Form and Report Button -->
    <div class="content">
        <div class="container-fluid">
            <div class="row align-items-center">
                <!-- Search form -->
                <div class="col-md-8 col-sm-12 mb-2">
                    <form asp-controller="Transactions" asp-action="SearchReceipt" method="get" class="d-flex">
                        <input type="text" name="refNo" class="form-control rounded-pill me-2"
                               placeholder="LAB-20xxxxxx-0xxx" required />
                        <button type="submit" class="btn btn-block btn-primary rounded-pill">
                            <i class="bi bi-search"></i>&nbsp; Search by Ref.NO
                        </button>
                    </form>
                </div>

                <!-- Download report button -->
                @if (ViewBag.ReportAvailable == true)
                {
                    <div class="col-md-4 col-sm-12 text-md-end text-sm-start">
                        <a asp-action="DownloadReport" asp-route-refNo="@ViewBag.RefNo"
                           class="btn btn-success btn-lg rounded-pill shadow-sm px-4">
                            <i class="bi bi-file-earmark-arrow-down-fill"></i> &nbsp; Download Lab Report
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
