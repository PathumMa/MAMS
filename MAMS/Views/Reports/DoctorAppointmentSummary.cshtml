@using MAMS.Models.ViewModels.Reports

@model List<DoctorAppointmentSummaryViewModel>
@{
    ViewData["Title"] = "Doctor Appointment Summary";
    var selectedDate = ViewBag.SelectedDate as DateTime? ?? DateTime.Today;
}

<div class="container">
    <div class="card card-outline card-primary">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
            <h5 class="mb-2 mb-md-0">Doctor Appointment Summary - @selectedDate.ToString("dd/MM/yyyy")</h5>
            <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-warning rounded-pill">
                <i class="bi bi-plus-circle"></i> All Reports
            </a>

            <form method="get" class="d-flex align-items-center gap-2">
                <input type="date" name="date" class="form-control form-control-sm rounded-pill" value="@selectedDate.ToString("yyyy-MM-dd")" style="width: 200px;" />
                <button type="submit" class="btn btn-sm btn-primary rounded-pill">Search</button>
            </form>
        </div>

        <div class="card-body table-responsive p-4">
            @if (Model.Any())
            {
                <div class="text-end mb-3">
                    <a class="btn btn-success rounded-pill" asp-action="DownloadDoctorAppointmentSummaryPdf" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")">
                        <i class="bi bi-download"></i> Download PDF
                    </a>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center">
                    No appointments found for the selected date.
                </div>
            }

            <table class="table table-bordered table-striped text-center">
                <thead class="table-dark">
                    <tr>
                        <th>Appointment #</th>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Specialization</th>
                        <th>Day</th>
                        <th>Time Slot</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.AppointmentNumber</td>
                            <td>@item.PatientName</td>
                            <td>@item.DoctorName</td>
                            <td>@item.Specialization</td>
                            <td>@item.Available_Day</td>
                            <td>@item.TimeSlot</td>
                            <td>
                                @if (item.Status == 1)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {

                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
