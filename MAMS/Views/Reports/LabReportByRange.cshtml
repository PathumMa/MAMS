@using MAMS.Models.ViewModels.Reports
@model List<LabBookingSummaryViewModel>

@{
    ViewData["Title"] = "Lab Booking By Range Report";
    var startDate = Context.Request.Query["date"].FirstOrDefault() ?? DateTime.Today.ToString("yyyy-MM-dd");
    var endDate = Context.Request.Query["date"].FirstOrDefault() ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="container">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-12 d-flex justify-content-between align-items-center">
                    <h1>Reports</h1>
                    <a asp-controller="Reports" asp-action="Index" class="btn bg-gradient-warning rounded-pill">
                        <i class="bi bi-plus-circle"></i> All Reports
                    </a>
                </div>
                <div class="col-sm-12">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="#">Admin</a></li>
                        <li class="breadcrumb-item active">All Reports</li>
                    </ol>
                </div>
            </div><!-- /.row -->
        </div><!-- /.container-fluid -->
    </div>

    <div class="content">
        <div class="row">
            <div class="col-12">
                <div class="card card-info card-outline">
                    <div class="card-header px-3 py-2">
                        <div class="d-flex justify-content-between align-items-center w-100 flex-wrap">
                            <h5 class="mb-2 mb-md-0">Range ab Report - @DateTime.Parse(startDate).ToString("dd/MM/yyyy") to @DateTime.Parse(endDate).ToString("dd/MM/yyyy") </h5>
                            

                            <form method="get" class="d-flex align-items-center gap-2 flex-nowrap">
                                <input type="date" name="startDate" class="form-control form-control-sm rounded-pill px-3" value="@startDate" style="width: 200px;" />
                                <input type="date" name="endDate" class="form-control form-control-sm rounded-pill px-3" value="@endDate" style="width: 200px;" />
                                <button type="submit" class="btn btn-sm btn-primary rounded-pill px-4 d-flex align-items-center gap-1">
                                    <i class="bi bi-search"></i> <span>Search</span>
                                </button>
                            </form>
                        </div>
                    </div>


                    <div class="card-body table-responsive p-4">
                        @if (Model.Any())
                        {
                            <div class="mb-1 text-end">
                                <a class="btn btn-outline-danger rounded-pill px-4" asp-action="DownloadLabReportPdf" asp-route-startDate="@startDate" asp-route-endDate="@endDate">
                                    <i class="bi bi-file-earmark-arrow-down"></i>&nbsp; Download PDF
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning text-center">
                                No records found for the selected date.
                            </div>
                        }

                        <table class="table table-striped table-bordered align-middle text-center">
                            <thead class="table-dark">
                                <tr>
                                    <th>Reference No</th>
                                    <th>Patient</th>
                                    <th>Lab Test</th>
                                    <th>Booked Date</th>
                                    <th>Time Slot</th>
                                    <th>Payment Method</th>
                                    <th>Amount Paid</th>
                                    <th>Issued</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.ReferenceNo</td>
                                        <td>@item.PatientName</td>
                                        <td>@item.LabName</td>
                                        <td>@item.BookedDate.ToString("dd/MM/yyyy")</td>
                                        <td>@item.TimeSlot</td>
                                        <td>@item.PaymentMethod</td>
                                        <td>Rs. @item.TotalPaid?.ToString("F2")</td>
                                        <td>@item.IssuedDate?.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div> <!-- card-body -->
                </div> <!-- card -->
            </div>
        </div>
    </div>
</div>
