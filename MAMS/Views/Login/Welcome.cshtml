@{
    ViewData["Title"] = "Welcome to MedEase";
    Layout = "~/Views/Shared/_GuestLayout.cshtml";
}

<!-- Optional body class for AdminLTE layout -->
<body class="hold-transition layout-top-nav" style="background: linear-gradient(to right top, #051937, #10315e, #1a4c89, #1f69b6, #1e88e5, #08d087); color: white;">
    <div class="wrapper">

        <!-- Header / Navbar -->
        <nav class="main-header navbar navbar-expand-md navbar-light navbar-white shadow-sm" style="background: linear-gradient(to right top, #051937, #10315e, #1a4c89, #1f69b6, #1e88e5, #08d087); color: white;>
            <div class="container">
                <a href="#" class="navbar-brand d-flex align-items-center">
                    <div style="background-color: white; border-radius: 50%; padding: 5px; display: inline-block; height: 40px; width: 40px;">
                        <img src="~/img/MedEase.png" alt="MAMS Logo" class="brand-image img-circle elevation-3" style="height: 30px; width: 30px; object-fit: contain;">
                    </div>
                    <span class="brand-text font-weight-bold text-white ml-2">MAMS</span>
                </a>

                <button class="navbar-toggler order-1" type="button" data-toggle="collapse" data-target="#navbarCollapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse order-3" id="navbarCollapse">
                    <ul class="navbar-nav ml-auto">
                        <li class="nav-item">
                            <a href="@Url.Action("Login", "Login")" class="nav-link  text-white">
                                <i class="fas fa-sign-in-alt mr-1"></i> Login
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Hero Section -->
        <div class="content-wrapper" style="background-color: #e6f0ff;">
            <div class="content-header text-center py-4">
                <div class="container">
                    <!-- Logo centered above -->
                    <div class="mb-4">
                        <img src="~/img/MedEase.png" alt="MAMS Logo" class="img-fluid" style="height: 80px; object-fit: contain;">
                    </div>
                    <h1 class="display-4 text-primary font-weight-bold">Welcome to MedEase&#8482;</h1>
                    <p class="lead" style="color: #4a4a4a;">
                       Your Trusted Health Partner, Your complete solution.
                    </p>
                    <a href="@Url.Action("Login", "Login")" class="btn btn-lg btn-info mt-3">
                        <i class="fas fa-user-md mr-1"></i> Get Started
                    </a>
                </div>
            </div>

            <!-- Services Section -->
            <section class="content" style="background: linear-gradient(to right top, #051937, #10315e, #1a4c89, #1f69b6, #1e88e5, #08d087); color: white;">
    <div class="container py-3">
        <h3 class="text-center mb-4 font-weight-bold">Our Services</h3>
        <div class="row">
            <div class="col text-center mb-4 d-flex">
                <div class="card bg-white border-0 shadow-lg h-80 d-flex flex-column w-100">
                    <div class="card-body d-flex flex-column">
                        <i class="fas fa-calendar-check fa-3x text-success mb-3"></i>
                        <h5 class="card-title font-weight-bold">Appointment Booking</h5>
                        <p class="card-text flex-grow-1">Book appointments with doctors based on availability, location, and specialization.</p>
                    </div>
                </div>
            </div>

            <div class="col text-center mb-4 d-flex">
                <div class="card bg-white border-0 shadow-lg h-80 d-flex flex-column w-100">
                    <div class="card-body d-flex flex-column">
                        <i class="fas fa-vials fa-3x text-red mb-3"></i>
                        <h5 class="card-title font-weight-bold">Lab Test Booking</h5>
                        <p class="card-text flex-grow-1">Schedule and view lab test reports directly from your dashboard.</p>
                    </div>
                </div>
            </div>

            <div class="col text-center mb-4 d-flex">
                <div class="card bg-white border-0 shadow-lg h-80 d-flex flex-column w-100">
                    <div class="card-body d-flex flex-column">
                        <i class="fas fa-notes-medical fa-3x text-warning mb-3"></i>
                        <h5 class="card-title font-weight-bold">Medical Records</h5>
                        <p class="card-text flex-grow-1">Access your appointment history, lab reports, and health details in one place.</p>
                    </div>
                </div>
            </div>

            <div class="col text-center mb-4 d-flex">
                <div class="card bg-white border-0 shadow-lg h-80 d-flex flex-column w-100">
                    <div class="card-body d-flex flex-column">
                        <i class="bi bi-file-earmark-break fa-3x text-warning mb-1"></i>
                        <h5 class="card-title font-weight-bold">Lab Reports</h5>
                        <p class="card-text flex-grow-1">Easily retrieve your lab report anytime.</p>
                        <a href="@Url.Action("GuestBookings", "LabBooking")" class="btn btn-sm btn-primary mt-auto">
                            Get Lab Report
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


            <!-- Footer -->
            <footer class="main-footer text-center bg-white border-top pt-3" style="background-color: #e6f0ff;" >
                <strong>&copy; 2025 MAMS</strong> — MedEase Appointment Management System. All rights reserved.
            </footer>
        </div>
    </div>
</body>
