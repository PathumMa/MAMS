@using MAMS.Models.ViewModels
@using static MAMS.Services.Enums
@model LabBookingViewModel

<div class="container">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-12 d-flex justify-content-between align-items-center">
                    <h1>Book Lab Test</h1>

                </div>
                <div class="col-sm-12">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-action="Index">Labs</a></li>
                        <li class="breadcrumb-item active">Make New</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <div class="content">
        <div class="container-fluid">

            @if (ViewBag.LabName != null && ViewBag.Price != null)
            {
                <div class="alert alert-info">
                    <strong>Lab Test:</strong> @ViewBag.LabName <br />
                    <strong>Price:</strong> LKR @ViewBag.Price
                </div>
            }

            <form method="post" asp-action="CreateBooking" asp-controller="LabBooking">
                <!-- Hidden field to retain LabTypeId -->
                <input type="hidden" asp-for="LabTypeId" />

                <div class="row gy-1 mb-1">
                    <div class="col mb-4 form-group">
                        <label asp-for="PersonalId"></label>
                        <input asp-for="PersonalId" class="form-control rounded-pill" required />
                    </div>

                    <div class="col mb-4 form-group">
                        <label asp-for="@Model.PersonalIdType" class="form-label">Personal Id: *</label>
                        <select asp-for="@Model.PersonalIdType" id="idTypeSelect" class="form-select rounded-pill" required>
                            <option value="">-- Select Personal ID Type --</option>
                            @foreach (var idType in Enum.GetValues(typeof(PersonalIdType)))
                            {
                                <option value="@idType">@idType</option>
                            }
                        </select>
                    </div>
                    <div class="col mb-4 form-group">
                        <label asp-for="PhoneNumber"></label>
                        <input asp-for="PhoneNumber" class="form-control rounded-pill" required />
                    </div>
                </div>
                
                <div class="row gy-1 mb-1">
                    <div class="col-2 mb-4 form-group">
                        <label asp-for="@Model.UserTitle" class="form-label">Title:</label>
                        <select asp-for="@Model.UserTitle" class="form-select rounded-pill">
                            <option value="">--Title--</option>
                            @foreach (var uTitle in Enum.GetValues(typeof(UserTitleType)))
                            {
                                <option value="@uTitle">@uTitle</option>
                            }
                        </select>
                    </div>

                    <div class="col-5 mb-4 form-group">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" class="form-control rounded-pill" required />
                    </div>
                    <div class="col-5 mb-4 form-group">
                        <label asp-for="Address"></label>
                        <input asp-for="Address" class="form-control rounded-pill" />
                    </div>
                </div>

                <div class="row gy-1 mb-1">
                    <div class="col mb-4 form-group">
                        <label asp-for="BookedDate">Booking Date:</label>
                        <input asp-for="BookedDate" type="date" class="form-control rounded-pill" required min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col mb-4 form-group">
                        <label asp-for="PaymentMethod"></label>
                        <select asp-for="PaymentMethod" class="form-control rounded-pill" required>
                            <option value="">--Select Payment--</option>
                            <option>Cash</option>
                            <option>Card</option>
                        </select>
                    </div>
                </div>

                

                <button type="submit" class="btn btn-success">Book Lab Test</button>
            </form>
        </div>
    </div>
</div>