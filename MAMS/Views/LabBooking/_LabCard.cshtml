@using static MAMS.Services.Enums
@model MAMS.Models.ViewModels.LabTypeViewModel

<div class="col-md-3 col-sm-6 mb-1">
    <div class="card shadow rounded border-info">
        <!-- Header -->
        <div class="card-header bg-info text-white py-2 px-3">
            <h5 class="mb-0 fw-bold">@Model.LabName</h5>
        </div>

        <!-- Body -->
        <div class="card-body pb-2 pt-3 px-3">  <!-- reduced padding bottom -->
            <h6 class="text-primary fw-semibold mb-2">
    @(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)
</h6>

            <p class="mb-1"><strong>Category:</strong> @Model.CategoryName</p>
            <p class="mb-1"><strong>Fee:</strong> Rs. @Model.Price.ToString("N2")</p>
            <p class="mb-0"><strong>Status:</strong>
                @if (Model.IsActive == ActiveStatus.Active)
                {
                    <span class="badge bg-success">Available</span>
                }
                else
                {
                    <span class="badge bg-danger">Unavailable</span>
                }
            </p>
        </div>

        <!-- Footer -->
        <div class="card-footer bg-white border-0 py-1 px-3 text-end">
    @if (Model.IsActive == ActiveStatus.Active)
    {
        <a asp-action="Booking"
           asp-controller="LabBooking"
           asp-route-labTypeId="@Model.LabTypeId"
           class="btn btn-outline-warning btn-sm rounded-pill px-3 py-1">
            <i class="bi bi-bookmark-plus"></i> &nbsp; Book Now
        </a>
    }
    else
    {
        <a class="btn btn-secondary btn-sm rounded-pill px-3 py-1 disabled" aria-disabled="true" tabindex="-1">
            <i class="bi bi-bookmark-x"></i>&nbsp; Try Later
        </a>
    }
</div>
    </div>
</div>

