@using System.Data
@using MAMS.Services
@using MAMS.Models.ViewModels
@using static MAMS.Services.Enums

@{
    ViewData["Title"] = "Search My Labs";
}

@model IEnumerable<DoctorDetails>

<div class="container">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-12 d-flex justify-content-between align-items-center">
                    <h1>My Lab Bookings</h1>
                </div>
                <div class="col-sm-12">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-action="Index">Labs</a></li>
                        <li class="breadcrumb-item active">Search</li>
                    </ol>
                </div>
            </div><!-- /.row -->
        </div><!-- /.container-fluid -->
    </div>

    <div class="content">
        <div class="container-fluid">
            <form asp-action="SearchReceipt" method="get" class="form-inline">
                <input type="text" name="refNo" class="form-control rounded-pill" placeholder="Enter Reference No" required />
                <button type="submit" class="btn btn-primary ml-2">Search</button>
            </form>

        </div>
    </div>
</div>
