@using MAMS.Services
@using MAMS.Models.ViewModels
@using static MAMS.Services.Enums

@{
    ViewData["Title"] = "Search Labs";
}

@model IEnumerable<LabTypeViewModel>

<div class="container">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-12 d-flex justify-content-between align-items-center">
                    <h1>Search Labs</h1>
                </div>
                <div class="col-sm-12">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Lab">Labs</a></li>
                        <li class="breadcrumb-item active">Search</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="content">
        <div class="container-fluid">
            <div class="info-box shadow">
                <span class="info-box-icon bg-info elevation-1 d-flex align-items-center justify-content-center"><i class="bi bi-search"></i></span>
                <div class="info-box-content w-100">
                    <form method="get" asp-action="SearchLabs" class="row align-items-center">
                        <div class="form-group col-md-5 mb-1">
                            <input type="text" class="form-control rounded-pill" id="LabName" name="labName" placeholder="Enter lab name" />
                        </div>
                        <div class="form-group col-md-5 mb-1">
                            <select id="LabCategory" name="categoryId" class="form-select rounded-pill">
                                <option value="">--Select Category--</option>
                                @foreach (var category in ViewBag.Categories)
                                {
                                    <option value="@category.LabCategoryId">@category.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2 mb-2 text-center">
                            <button type="submit" class="btn btn-block btn-primary rounded-pill w-100"> <i class="bi bi-search"></i> &nbsp; Search</button>
                        </div>
                    </form>
                </div>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="row row-cols-1 row-cols-md-3 g-4 mt-3">
                    @foreach (var lab in Model)
                    {
                        @await Html.PartialAsync("_LabCard", lab)
                    }
                </div>
            }
            else if (Model != null)
            {
                <div class="alert alert-warning mt-3" role="alert">
                    No labs found matching your criteria.
                </div>
            }
        </div>
    </div>
</div>
