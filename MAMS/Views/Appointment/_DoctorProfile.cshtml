@model MAMS.Models.DoctorDetails

<div class="col-md-3">
    <div class="card card-widget widget-user shadow-sm mb-4">
        <!-- Header -->
        <div class="widget-user-header bg-info text-white text-center py-2 position-relative">
            <h6 class="mb-0">@Model.Specialization?.Specializations_Name</h6>
        </div>

        <!-- Image (Adjusted Position) -->
        <div class="widget-user-image text-center" style="top: 55px; background-color: white; border-radius: 50%; padding: 6px; display: inline-block;">
            <img class="img-circle elevation-2" src="~/img/Doctor.png" alt="Doctor Avatar">
        </div>

        <!-- Body -->
        <div class="card-body text-center pt-4 mt-3" style="padding-bottom: 1rem;">
            <h5 class="widget-user-username mb-2">@Model.First_Name @Model.Last_Name</h5>

            <input asp-for="SuserId" hidden />
            <input asp-for="Id" hidden />

            <a asp-action="Availabilities" asp-route-id="@Model.Id"
               class="btn btn-info btn-sm btn-block rounded-pill mt-2">
                <b>Book Appointment</b>
            </a>
        </div>
    </div>
</div>
