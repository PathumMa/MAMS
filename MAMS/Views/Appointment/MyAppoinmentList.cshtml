@model List<MAMS.Models.ViewModels.AppointmentsViewModel>

@{
    ViewData["Title"] = "My Appointments";
}

<div class="container">

    <div class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-12 d-flex justify-content-between align-items-center">
                    <h1>Appointments</h1>
                </div>
                <div class="col-sm-12">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-action="Search">Appointments</a></li>
                        <li class="breadcrumb-item active">My Appointments</li>
                    </ol>
                </div>
            </div><!-- /.row -->
        </div><!-- /.container-fluid -->
    </div>

    <div class="content">
        <div class="container-fluid">
            <!-- Info box for searching appointments -->
            <div class="info-box shadow">
                <span class="info-box-icon bg-olive"><i class="bi bi-calendar-check"></i></span>
                <div class="info-box-content">
                    <p>View and manage your appointments.</p>
                    <form method="get" asp-action="PatientBookingList" class="row g-3">
                        <div class="col-3">
                            <label for="startDate" class="form-label">Start Date</label>
                            <input type="date" id="startDate" name="startDate" class="form-control" value="@Context.Request.Query["startDate"]" />
                        </div>
                        <div class="col-3">
                            <label for="endDate" class="form-label">End Date</label>
                            <input type="date" id="endDate" name="endDate" class="form-control" value="@Context.Request.Query["endDate"]" />
                        </div>

                        <div class="col-3">
                            <label for="PersonalId" class="form-label" placeholder="NIC/Driving L/Passport">Personal ID</label>
                            <input type="text" id="personalId" name="personalId" class="form-control" value="@Context.Request.Query["patientId"]" required placeholder="NIC/Driving L/Passport" />
                        </div>
                        <div class="col-3 align-self-end">
                            <button type="submit" class="btn btn-primary">Search &nbsp; <i class="bi bi-search"></i></button>
                            <a asp-controller="Appointment" asp-action="AppoinmentList" class="btn btn-secondary">Reset &nbsp; <i class="bi bi-arrow-clockwise"></i></a>
                        </div>
                    </form>
                </div>
            </div>
            <!-- /.info-box -->

            @{
                var hasSearch = !string.IsNullOrEmpty(Context.Request.Query["startDate"])
                    || !string.IsNullOrEmpty(Context.Request.Query["endDate"])
                    || !string.IsNullOrEmpty(Context.Request.Query["patientId"]);
            }

            @if (Model != null && Model.Any())
            {
                @foreach (var patientGroup in Model.GroupBy(m => new { m.PatientTitle, m.PatientName, m.PersonalId }))
                {
                    <table class="table table-striped mb-4">
                        <thead class="table-dark">
                            <tr>
                                <th colspan="5" class="table-success table-active text-center">
                                    @patientGroup.Key.PatientTitle @patientGroup.Key.PatientName - @patientGroup.Key.PersonalId
                                </th>
                            </tr>
                            <tr class="text-center">
                                <th>Appointment No</th>
                                <th>Date</th>
                                <th>Day</th>
                                <th>Doctor</th>
                                <th>Fees (LKR)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in patientGroup)
                            {
                                <tr>
                                    <td class="text-center">@appt.Appoinment_number</td>
                                    <td class="text-center">@appt.Appointment_Date.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">@appt.Appointment_Date.ToString("dddd")</td>
                                    <td class="text-center">@appt.DoctorName / @appt.DoctorSpecialization</td>
                                    <td class="text-end">
                                        @{
                                            var total = (appt.Doctor_fee ?? 0) + (appt.Hospital_fee ?? 0) - (appt.Discount ?? 0);
                                        }
                                        @total.ToString("N2")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
            else if (hasSearch)
            {
                <div class="alert alert-info">No appointments found for the selected date range.</div>
            }
        </div>
    </div>

</div>
