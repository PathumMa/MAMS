@model MAMS.Models.ViewModels.DoctorDetailsViewModel

<div class="g-col-6">
    <div class="card shadow-sm border rounded">
        <div class="card-header py-2 px-3 bg-info text-white border-bottom">
            <h5 class="mb-0">
                @Model.UserTitle. <strong>@Model.First_Name</strong> @Model.Last_Name
            </h5>
            <input asp-for="Id" type="hidden" />
        </div>

        <div class="card-body px-3 py-2">
            <div class="row">
                <div class="col-8">
                    <p class="text-muted mb-2">
                        <strong>Specialization:</strong> @Model.Specializations?.Specializations_Name
                    </p>
                    <ul class="fa-ul text-muted small mb-2 ps-0">
                        <li class="mb-2">
                            <span class="fa-li"><i class="fas fa-building"></i></span>
                            <strong>Address:</strong> @Model.Address
                        </li>
                        <li class="mb-2">
                            <span class="fa-li"><i class="fas fa-phone"></i></span>
                            <strong>Phone:</strong> @Model.PhoneNumber
                        </li>
                    </ul>
                </div>

                <div class="col-4 text-center d-flex align-items-center justify-content-center">
                    <img src="~/adminlte/dist/img/user1-128x128.jpg" alt="Doctor Avatar" class="img-fluid rounded-circle shadow-sm" style="max-width: 80px;" />
                </div>
            </div>
        </div>

        <div class="card-footer py-2 px-3 bg-light border-top">
            <div class="text-end">
                <a asp-controller="Availability" asp-action="Index" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-success me-2">
                    <i class="bi bi-calendar-check"></i> Availability
                </a>
                <a asp-controller="Doctor" asp-action="Profile" asp-route-userName="@Model.UserName" class="btn btn-sm btn-outline-primary">
                    <i class="fas fa-user"></i> View Profile
                </a>
            </div>
        </div>
    </div>
</div>
